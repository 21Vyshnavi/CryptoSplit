# Copy to .env. Use unique secrets for every deployment.
MYSQL_PASSWORD=replace-with-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
JWT_ISSUER=cryptosplit
JWT_MINUTES=30
# Alternatively to DATABASE_URL, AWS ECS can inject these individually from Secrets Manager.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=cryptosplit
KEY_ENCRYPTION_BACKEND=rsa
KMS_KEY_ID=
# For cloud hosts that cannot mount the local secrets/ directory, use base64 PEM secrets.
RSA_PRIVATE_KEY_B64=
RSA_PUBLIC_KEY_B64=
MAX_UPLOAD_BYTES=52428800
FRAGMENT_BYTES=1048576
STORAGE_BACKEND=local
STORAGE_ROOT=/var/lib/cryptosplit/fragments
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cryptosplit
S3_ACCESS_KEY=minio-admin
S3_SECRET_KEY=replace-with-long-random-object-store-password
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
